{
  "name": "fund-tracker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/ios"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "backtest:valuation": "node scripts/backtest-valuation.js --days=40 --live",
    "calibrate:valuation": "node scripts/calibrate-valuation.js --days=25",
    "test:fund-estimate": "node server/fund-estimate.test.js",
    "test:display-session": "node server/display-session.test.js",
    "test:phase-transition": "node server/phase-transition.test.js",
    "test:timeline-audit": "node server/timeline-audit.test.js",
    "test:fund-holding-fields": "node server/fund-holding-fields.test.js",
    "test:fund-regular-eligibility": "node server/fund-regular-eligibility.test.js",
    "test:holdings-rt1": "node server/live-rt1-holdings.test.js",
    "test:scope-totals": "node server/scope-totals.test.js",
    "test:holding-market": "node server/holding-market.test.js",
    "test:market-session": "node server/market-session.test.js",
    "test:nav-display": "node server/nav-display.test.js",
    "test:table-head": "node server/table-head.test.js",
    "test:day-display-baseline": "node server/day-display-baseline.test.js",
    "test:fund-metrics-live": "node server/fund-metrics-live.test.js",
    "test:impact-snapshots": "node server/impact-snapshots.test.js",
    "test:weight-model": "node server/weight-model.test.js",
    "test:market-indices": "node server/market-indices.test.js",
    "test:gb-quote-parse": "node server/gb-quote-parse.test.js",
    "test:live-view-model": "node packages/core/live-view-model.test.js",
    "test:regression": "npm run test:fund-estimate && npm run test:realtime-profit && npm run test:display-session && npm run test:display-state && npm run test:live-pipeline && npm run test:realtime-display-pipeline && npm run test:phase-transition && npm run test:timeline-audit && npm run test:fund-holding-fields && npm run test:fund-regular-eligibility && npm run test:holdings-rt1 && npm run test:scope-totals && npm run test:holding-market && npm run test:market-session && npm run test:nav-display && npm run test:table-head && npm run test:day-display-baseline && npm run test:fund-metrics-live && npm run test:impact-snapshots && npm run test:weight-model && npm run test:market-indices && npm run test:gb-quote-parse && npm run test:live-view-model && npm run test:profit-calendar && npm run test:qdii-valuation && npm run test:api-contract",
    "test:display-state": "node server/snap-state.test.js",
    "test:live-pipeline": "node server/live-pipeline.test.js && node server/live-pipeline-reapply.test.js",
    "test:realtime-display-pipeline": "node server/realtime-display-pipeline.test.js",
    "test:realtime-profit": "node server/realtime-profit-consistency.test.js",
    "test:profit-calendar": "node server/profit-attribution.test.js && node server/profit-calendar.test.js && node server/profit-pending.test.js && node server/app-state.test.js",
    "backfill:profit-ledger": "node scripts/backfill-profit-ledger.js",
    "verify:profit-calendar": "node scripts/verify-profit-calendar.js",
    "test:qdii-valuation": "node server/qdii-valuation.test.js",
    "verify:alipay-realtime": "node scripts/verify-alipay-realtime.js",
    "verify:tab-reconcile": "node scripts/verify-tab-reconcile.js",
    "test:api-contract": "node server/api-contract.test.js",
    "mac:dev": "bash scripts/run-mac-dev.sh",
    "mac:build": "bash scripts/build-mac.sh",
    "mac:open": "open apps/mac/FundTracker.xcodeproj",
    "mac:install": "bash scripts/install-mac-app.sh && xattr -cr '/Applications/Fund Tracker.app' 2>/dev/null || true",
    "sync:mac-data": "bash scripts/sync-data-to-mac-app.sh",
    "screenshot:readme": "node scripts/capture-readme-screenshot.mjs",
    "ios:init": "npm run add-ios --workspace @fund-tracker/ios",
    "ios:sync": "npm run build && npm run sync --workspace @fund-tracker/ios",
    "ios:open": "npm run open --workspace @fund-tracker/ios"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.49.1",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@fund-tracker/api-client": "*",
    "@fund-tracker/core": "*",
    "@fund-tracker/storage": "*"
  },
  "optionalDependencies": {
    "pdf-parse": "^2.4.5"
  }
}
