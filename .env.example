# fund-tracker API / client env (copy to .env)

# API port (dev default 8788; Mac Swift App sidecar uses 8790)
PORT=8788

# Override data directory (Mac App: Application Support/data)
# FUND_TRACKER_DATA_DIR=

# Remote API auth — set on VPS; clients send Authorization: Bearer
# FUND_TRACKER_API_TOKEN=

# CORS origins (comma-separated). Omit or * for dev.
# FUND_TRACKER_CORS_ORIGINS=https://your-domain.com

# Vite build — Remote API base for iPhone / miniprogram web bundle
# VITE_API_BASE=https://api.example.com
# VITE_API_TOKEN=
